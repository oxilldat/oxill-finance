{
  "name": "oxill-finance",
  "version": "1.0.0",
  "description": "Local-first personal finance planning for Obsidian using Markdown notes.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "npm run check && node esbuild.config.mjs production",
    "check": "tsc --noEmit",
    "test": "esbuild ./src/core/finance.test.ts --bundle --platform=node --format=cjs --outfile=./.test/finance.test.cjs && node --test ./.test/finance.test.cjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oxilldat/oxill-finance.git"
  },
  "homepage": "https://github.com/oxilldat/oxill-finance#readme",
  "bugs": {
    "url": "https://github.com/oxilldat/oxill-finance/issues"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "esbuild": "^0.24.0",
    "obsidian": "^1.13.0",
    "typescript": "^5.6.3"
  }
}

